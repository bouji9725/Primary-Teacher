# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/teacher_app"

# Resend email API key — get one at https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# The email address that receives new booking notifications (teacher's email)
TEACHER_EMAIL="teacher@example.com"

# The "from" address used in outgoing emails
# Must be a verified domain in Resend
FROM_EMAIL="bookings@yourdomain.com"

# Admin panel password — choose something strong
ADMIN_PASSWORD="change-me-to-something-strong"

# Secret used to sign the admin session cookie — any long random string
ADMIN_SECRET="change-me-to-a-random-64-char-secret"
